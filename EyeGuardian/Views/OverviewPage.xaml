<UserControl x:Class="EyeGuardian.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题与右侧标签同基线 -->
        <Grid Grid.Row="0" Height="34" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource ov.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,4"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="FocusTodayText" Text="今日用眼 0 分钟" FontSize="11"
                           Foreground="{StaticResource AccentDeepBrush}" />
            </Border>
        </Grid>

        <!-- 主卡片 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 圆环（点击预览） -->
                <StackPanel VerticalAlignment="Center">
                    <Grid x:Name="RingArea" Width="188" Height="188" Cursor="Hand"
                          MouseLeftButtonUp="RingArea_Click" ToolTip="{DynamicResource ov.preview}">
                        <Ellipse Stroke="{StaticResource RingTrackBrush}" StrokeThickness="10" Margin="5" />
                        <Path x:Name="Ring" Stroke="{StaticResource AccentBrush}" StrokeThickness="10"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CountdownText" Text="30:00" Style="{StaticResource Num}"
                                       FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CountdownLabel" Text="距下次休息" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PreviewHint" FontSize="10" Margin="0,8,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="26,0,2,0" VerticalAlignment="Center">
                    <Border x:Name="StateBadge" Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                            Padding="9,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Text="保护中" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TipText" FontSize="14.5"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                               LineHeight="24" Margin="0,12,0,0" MaxHeight="50" />

                    <Border Height="1" Background="{StaticResource StrokeSoftBrush}" Margin="0,16,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ov.toNextShort}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ShortCountdownText" Text="30:00" Style="{StaticResource Num}"
                                       FontSize="20" Foreground="{StaticResource AccentDeepBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource ov.toNextLong}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="LongCountdownText" Text="45:00" Style="{StaticResource Num}"
                                       FontSize="20" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BreakNowBtn" Content="{DynamicResource ov.breakNow}" Style="{StaticResource PrimaryBtn}" Click="BreakNow_Click" />
                <Button x:Name="PauseBtn" Content="{DynamicResource ov.pause}" Style="{StaticResource SoftBtn}" Margin="8,0,0,0" Click="Pause_Click" />
                <Button x:Name="ResumeBtn" Content="{DynamicResource ov.resume}" Style="{StaticResource SoftBtn}" Margin="8,0,0,0"
                        Click="Resume_Click" Visibility="Collapsed" />
                <Button x:Name="StartBtn" Content="{DynamicResource ov.start}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                        Click="Start_Click" Visibility="Collapsed" />
                <Button x:Name="StopBtn" Content="{DynamicResource ov.stop}" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" Click="Stop_Click" />
            </StackPanel>
            <Button x:Name="PreviewBtn" Content="{DynamicResource ov.preview}" Style="{StaticResource GhostBtn}"
                    HorizontalAlignment="Right" Click="Preview_Click" />
        </Grid>

        <!-- 今日数据 -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,14,0,0">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ov.todayShort}" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TodayShort" Text="0" Style="{StaticResource Num}" FontSize="23"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="ShortUnit" Text="次" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ov.todayLong}" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TodayLong" Text="0" Style="{StaticResource Num}" FontSize="23" />
                        <TextBlock x:Name="LongUnit" Text="次" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ov.todayFocus}" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TodayFocus" Text="0" Style="{StaticResource Num}" FontSize="23" />
                        <TextBlock x:Name="FocusUnit" Text="分钟" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="4" x:Name="Footnote" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="2,12,2,2" />
    </Grid>
</UserControl>
