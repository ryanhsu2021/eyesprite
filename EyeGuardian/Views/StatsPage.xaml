<UserControl x:Class="EyeGuardian.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel Margin="0,0,8,2">

            <Grid Height="34" Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource sg.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <TextBlock x:Name="StreakText" Text="连续达标 0 天" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource sg.todayShort}" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="SShort" Text="0" Style="{StaticResource Num}" FontSize="22"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource ov.times}" FontSize="11" Margin="5,0,0,3"
                                       VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource sg.todayLong}" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="SLong" Text="0" Style="{StaticResource Num}" FontSize="22" />
                            <TextBlock Text="{DynamicResource ov.times}" FontSize="11" Margin="5,0,0,3"
                                       VerticalAlignment="Bottom" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource sg.todayFocus}" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="SFocus" Text="0" Style="{StaticResource Num}" FontSize="22" />
                            <TextBlock Text="{DynamicResource ov.minutes}" FontSize="11" Margin="5,0,0,3"
                                       VerticalAlignment="Bottom" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource sg.todaySkip}" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="SSkip" Text="0" Style="{StaticResource Num}" FontSize="22"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{DynamicResource ov.times}" FontSize="11" Margin="5,0,0,3"
                                       VerticalAlignment="Bottom" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource sg.last7}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource sg.legendShort}" FontSize="10.5" Margin="5,0,12,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentMidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource sg.legendLong}" FontSize="10.5" Margin="5,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="BarsHost" Columns="7" Height="150" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,2" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource sg.total}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TotalText" Text="共 0 次休息 · 0 小时用眼" FontSize="13.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource sg.clear}" Style="{StaticResource GhostBtn}"
                            Click="Reset_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
