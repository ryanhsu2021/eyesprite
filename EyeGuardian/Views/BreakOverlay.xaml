<Window x:Class="EyeGuardian.Views.BreakOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource app.name}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="False" Background="#FF08130F"
        FontFamily="Microsoft YaHei UI" WindowStartupLocation="Manual"
        Cursor="Arrow" Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Storyboard x:Key="Breath" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.09" Duration="0:0:3.6" />
            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.09" Duration="0:0:3.6" />
        </Storyboard>

        <!-- 深色遮罩上的胶囊按钮：半透明描边 + 白字（GhostBtn 是白底深字，用在浅色界面） -->
        <Style x:Key="OverlayGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#14FFFFFF" BorderBrush="#3DFFFFFF" BorderThickness="1"
                                CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.34" Center="0.5,0.34" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#FF1A3B31" Offset="0" />
                <GradientStop Color="#FF0B1D17" Offset="0.6" />
                <GradientStop Color="#FF050C09" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：预览标记 + 当前时间 -->
            <Grid Grid.Row="0" Margin="40,32,40,0">
                <Border x:Name="PreviewBadge" Background="#26FFFFFF" CornerRadius="16" Padding="14,6"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource br.previewBadge}" FontSize="11.5" Foreground="#F2FFFFFF" />
                </Border>

                <Border Background="#14FFFFFF" CornerRadius="18" Padding="16,8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#A6FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource br.now}" FontSize="12.5" Foreground="#A6FFFFFF"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClockText" Text="21:25" FontSize="17" FontWeight="SemiBold"
                                   Foreground="White" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 主显示器内容 -->
            <StackPanel x:Name="MainPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <TextBlock x:Name="KindText" Text="该休息啦" FontSize="17" FontWeight="SemiBold"
                           Foreground="#FF8FD7BC" HorizontalAlignment="Center" />

                <Grid Width="380" Height="380" Margin="0,14,0,0">
                    <Ellipse x:Name="Glow" Fill="#12FFFFFF" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="1.2" Margin="26" />
                    <Path x:Name="Ring" Stroke="#99FFFFFF" StrokeThickness="3.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="01:00" FontSize="86" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock x:Name="UnitText" Text="休息剩余" FontSize="14"
                                   Foreground="#B3FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TipText" Text="把视线移到 6 米以外的远处"
                           FontSize="22" Foreground="#F2FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="680" Margin="0,16,0,0" LineHeight="36" />

                <Button x:Name="SkipBtn" Content="跳过这次休息" Style="{StaticResource OverlayGhostBtn}"
                        Margin="0,30,0,0" HorizontalAlignment="Center" Click="Skip_Click" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="BrandText" Text="护眼精灵" FontSize="11.5"
                       Foreground="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,30" />

            <!-- 副显示器内容 -->
            <TextBlock x:Name="SecondaryText" Text="休息中" FontSize="26" Foreground="#59FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
