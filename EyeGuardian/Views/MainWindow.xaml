<Window x:Class="EyeGuardian.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource app.name}" Width="960" Height="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="False" Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- 用 WindowChrome 代替 AllowsTransparency：分层窗口会退化成灰度抗锯齿（文字发虚），
         WindowChrome 保留 ClearType，同时由系统给窗口圆角和投影。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏（CaptionHeight 区域内由系统处理拖动与双击） -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Grid Width="20" Height="20">
                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
                </Grid>
                <TextBlock Text="{DynamicResource app.name}" Margin="9,0,0,0" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                        Click="Min_Click" ToolTip="最小化" />
                <Button Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        Click="Close_Click" ToolTip="关闭" Margin="2,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏：纯深绿，扁平 -->
            <Border Background="{StaticResource SidebarBrush}" CornerRadius="12" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 状态区 -->
                    <StackPanel Margin="6,0,6,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#FF6FE3B0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SideStatus" Text="保护中" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="14,7,0,0">
                            <TextBlock x:Name="SideNextShort" Text="下次短休 30:00" FontSize="11"
                                       Foreground="{StaticResource SidebarTextBrush}" />
                            <TextBlock x:Name="SideNextLong" Text="下次长休 60:00" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource SidebarMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 导航 -->
                    <ListBox x:Name="Nav" Grid.Row="1" Style="{StaticResource NavList}"
                             SelectionChanged="Nav_SelectionChanged" SelectedIndex="0">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource SidebarTextBrush}" />
                                <TextBlock Text="{DynamicResource nav.overview}" Margin="11,0,0,0" FontSize="13"
                                           VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource SidebarTextBrush}" />
                                <TextBlock Text="{DynamicResource nav.stats}" Margin="11,0,0,0" FontSize="13"
                                           VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource SidebarTextBrush}" />
                                <TextBlock Text="{DynamicResource nav.settings}" Margin="11,0,0,0" FontSize="13"
                                           VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- 底部今日小计 -->
                    <StackPanel Grid.Row="3">
                        <Border BorderBrush="#2BFFFFFF" BorderThickness="1" CornerRadius="9" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource side.today}" FontSize="10"
                                           Foreground="{StaticResource SidebarMutedBrush}" />
                                <TextBlock x:Name="SideTodayBreaks" Text="0 次短休 · 0 次长休" FontSize="11"
                                           Foreground="White" Margin="0,5,0,0" />
                                <TextBlock x:Name="SideTodayFocus" Text="已用眼 0 分钟" FontSize="11"
                                           Foreground="{StaticResource SidebarTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionText" FontSize="10"
                                   Foreground="#59FFFFFF" Margin="2,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>
