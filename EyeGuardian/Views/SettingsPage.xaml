<UserControl x:Class="EyeGuardian.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">

    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="68" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SubValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="Width" Value="78" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="42" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel Margin="0,0,8,2">

            <Grid Height="34" Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource se.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <TextBlock x:Name="SaveHint" Text="{DynamicResource se.autoSaved}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- 休息节奏 -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource se.rhythm}" Style="{StaticResource SectionLabel}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.shortGap}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.shortGapDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="ShortGap:-5" Click="Step_Click" />
                            <TextBlock x:Name="ShortGapText" Text="30 分钟" Style="{StaticResource ValueText}" />
                            <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="ShortGap:5" Click="Step_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.shortDuration}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.shortDurationDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="ShortDuration:-1" Click="Step_Click" />
                            <TextBlock x:Name="ShortDurationText" Text="1 分钟" Style="{StaticResource ValueText}" />
                            <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="ShortDuration:1" Click="Step_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.longGap}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.longGapDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="LongGap:-5" Click="Step_Click" />
                            <TextBlock x:Name="LongGapText" Text="60 分钟" Style="{StaticResource ValueText}" />
                            <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="LongGap:5" Click="Step_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.longDuration}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.longDurationDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="LongDuration:-5" Click="Step_Click" />
                            <TextBlock x:Name="LongDurationText" Text="5 分钟" Style="{StaticResource ValueText}" />
                            <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource StepBtn}" Tag="LongDuration:5" Click="Step_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 行为 -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource se.behavior}" Style="{StaticResource SectionLabel}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.force}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.forceDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ToggleButton x:Name="ForceSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="Switch_Click" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.idle}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.idleDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ToggleButton x:Name="IdleSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="Switch_Click" />
                    </Grid>

                    <!-- 开启后才展开：原理说明 + 两个参数 -->
                    <Border x:Name="IdlePanel" Visibility="Collapsed" Margin="0,4,0,10"
                            Background="#FFF8FBF9" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource se.idlePrinciple}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentDeepBrush}" />
                            <TextBlock Text="{DynamicResource se.idlePrincipleBody}" Style="{StaticResource RowDesc}"
                                       Margin="0,5,0,0" LineHeight="17" />

                            <Grid Margin="0,10,0,0" MinHeight="30">
                                <TextBlock Text="{DynamicResource se.idleThreshold}" Style="{StaticResource RowTitle}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource StepBtn}" Tag="IdleThreshold:-60" Click="Step_Click" />
                                    <TextBlock x:Name="IdleThresholdText" Text="2 分钟" Style="{StaticResource SubValue}" />
                                    <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource StepBtn}" Tag="IdleThreshold:60" Click="Step_Click" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,2,0,0" MinHeight="30">
                                <TextBlock Text="{DynamicResource se.idleAwayReset}" Style="{StaticResource RowTitle}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource StepBtn}" Tag="AwayReset:-1" Click="Step_Click" />
                                    <TextBlock x:Name="AwayResetText" Text="5 分钟" Style="{StaticResource SubValue}" />
                                    <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource StepBtn}" Tag="AwayReset:1" Click="Step_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.alert}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.alertDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ToggleButton x:Name="AlertSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="Switch_Click" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.sound}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.soundDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ToggleButton x:Name="SoundSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="Switch_Click" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.startup}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.startupDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ToggleButton x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="Switch_Click" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource se.minimized}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{DynamicResource se.minimizedDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <ToggleButton x:Name="MinimizedSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Click="Switch_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 语言 -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource se.language}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{DynamicResource se.langDesc}" Style="{StaticResource RowDesc}"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="LangAuto" GroupName="lang" Style="{StaticResource LangChoice}"
                                     Content="{DynamicResource se.langAuto}" Click="Lang_Click" Tag="auto" />
                        <RadioButton x:Name="LangZh" GroupName="lang" Style="{StaticResource LangChoice}"
                                     Content="{DynamicResource lang.zh}" Click="Lang_Click" Tag="zh-CN" />
                        <RadioButton x:Name="LangEn" GroupName="lang" Style="{StaticResource LangChoice}"
                                     Content="{DynamicResource lang.en}" Click="Lang_Click" Tag="en-US" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 休息提示语 -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,2">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,110,0">
                            <TextBlock Text="{DynamicResource se.tipsSection}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{DynamicResource se.tipsDesc}" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                        <TextBlock x:Name="TipCount" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Foreground="{StaticResource AccentDeepBrush}" />
                    </Grid>

                    <Border Background="#FFF8FBF9" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="9" Margin="0,12,0,0" Padding="4,5">
                        <ScrollViewer x:Name="TipScroll" MaxHeight="224" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TipList" />
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource se.tipsAdd}" Style="{StaticResource SoftBtn}"
                                    Padding="14,8" Click="AddTip_Click" />
                            <Button Content="{DynamicResource se.tipsReset}" Style="{StaticResource GhostBtn}"
                                    Padding="14,8" Margin="8,0,0,0" Click="ResetTips_Click" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource se.tipsHint}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
