    <sys:String x:Key="tip.blink">Blink slowly 10 times, holding each blink for 2 seconds to refresh your tear film</sys:String>
    <sys:String x:Key="tip.faraway">Find a spot 6 meters away, count to 20, then look back at the screen</sys:String>
    <sys:String x:Key="tip.kegel">Do 10 pelvic floor squeezes, holding each for 3 seconds</sys:String>
    <sys:String x:Key="tip.breathe">In for 4, hold for 4, out for 6. Three rounds</sys:String>
    <sys:String x:Key="tip.neck">Shrug your shoulders up to your ears, hold 5 seconds, release. Five times</sys:String>
    <sys:String x:Key="tip.stand">Stand up and stretch both arms overhead for 10 seconds</sys:String>
    <sys:String x:Key="tip.squat">Do 10 slow squats, keeping your knees behind your toes</sys:String>
    <sys:String x:Key="tip.eight">Trace a figure eight with your eyes, three slow laps, head still</sys:String>
    <sys:String x:Key="tip.palms">Rub your palms warm, then cup them over closed eyes for 30 seconds</sys:String>
    <sys:String x:Key="tip.temple">Massage your temples for 30 seconds and unclench your brow</sys:String>
    <sys:String x:Key="tip.waist">Hands on hips, lean back gently to take the load off your lower back</sys:String>
    <sys:String x:Key="tip.wrist">Interlace your fingers, turn the palms out and press up to open your wrists</sys:String>
    <sys:String x:Key="tip.water">Walk over and pour a glass of warm water. Sip it slowly</sys:String>
    <sys:String x:Key="tip.walk">Take a lap around the room and get your circulation going</sys:String>
    <sys:String x:Key="tip.focus">Find one near and one far object out the window, refocus between them 5 times</sys:String>
    <sys:String x:Key="tip.yawn">Fake a big yawn and let your jaw and face go slack</sys:String>

